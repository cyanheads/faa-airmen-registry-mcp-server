{
  "name": "@cyanheads/faa-airmen-registry-mcp-server",
  "version": "0.2.1",
  "mcpName": "io.github.cyanheads/faa-airmen-registry-mcp-server",
  "description": "Search FAA airmen certificates, ratings, and informational medical records via MCP. STDIO or Streamable HTTP.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "faa-airmen-registry-mcp-server": "dist/index.js",
    "faa-airmen-registry-mirror": "dist/cli/mirror.js"
  },
  "files": [
    "changelog/",
    "dist/",
    "!dist/*.mcpb",
    "README.md",
    "LICENSE",
    "CLAUDE.md",
    "AGENTS.md",
    "Dockerfile",
    "server.json",
    "!data/",
    "!docs/idea.md"
  ],
  "scripts": {
    "mirror:init": "node dist/cli/mirror.js init",
    "mirror:refresh": "node dist/cli/mirror.js refresh",
    "mirror:verify": "node dist/cli/mirror.js verify",
    "build": "bun run scripts/build.ts",
    "rebuild": "bun run scripts/clean.ts && bun run scripts/build.ts",
    "clean": "bun run scripts/clean.ts",
    "devcheck": "bun run scripts/devcheck.ts",
    "audit:fix": "bun audit fix",
    "audit:refresh": "rm -f bun.lock && bun install && bun audit",
    "tree": "bun run scripts/tree.ts",
    "list-skills": "bun run scripts/list-skills.ts",
    "format": "biome check --write .",
    "format:unsafe": "biome check --write --unsafe .",
    "lint:mcp": "bun run scripts/lint-mcp.ts",
    "lint:packaging": "bun run scripts/lint-packaging.ts",
    "bundle": "bun run build && npx -y @anthropic-ai/mcpb pack . dist/faa-airmen-registry-mcp-server.mcpb && bun run scripts/clean-mcpb.ts dist/faa-airmen-registry-mcp-server.mcpb",
    "changelog:build": "bun run scripts/build-changelog.ts",
    "changelog:check": "bun run scripts/build-changelog.ts --check",
    "release:github": "bun run scripts/release-github.ts",
    "publish-mcp": "mcp-publisher login github -token \"$(security find-generic-password -a \"$USER\" -s mcp-publisher-github-pat -w)\" && mcp-publisher publish",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js",
    "start:stdio": "MCP_TRANSPORT_TYPE=stdio node dist/index.js",
    "start:http": "MCP_TRANSPORT_TYPE=http node dist/index.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "typescript",
    "bun",
    "stdio",
    "streamable-http",
    "ai-agent",
    "faa",
    "airmen",
    "aviation",
    "pilot-certificates",
    "type-ratings",
    "local-mirror"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyanheads/faa-airmen-registry-mcp-server.git"
  },
  "homepage": "https://github.com/cyanheads/faa-airmen-registry-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/cyanheads/faa-airmen-registry-mcp-server/issues"
  },
  "author": "Casey Hand <casey@caseyjhand.com> (https://caseyjhand.com)",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/cyanheads"
    },
    {
      "type": "buy_me_a_coffee",
      "url": "https://www.buymeacoffee.com/cyanheads"
    }
  ],
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cyanheads/mcp-ts-core": "^0.13.16",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.3",
    "pino-pretty": "^13.2.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@socketsecurity/bun-security-scanner": "^1.1.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "26.6.5",
    "@types/yauzl": "^3.4.0",
    "@vitest/coverage-istanbul": "5.0.5",
    "depcheck": "^1.4.7",
    "fast-check": "^4.10.2",
    "ignore": "^7.0.13",
    "tsc-alias": "^1.9.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
